PORT=3001
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=techassistpro
# Gere com npm run chave e cole o resultado aqui. Não publique o .env.
JWT_SECRET=
CORS_ORIGENS=http://localhost:3000,http://127.0.0.1:3000

# Uso único opcional: provisionar uma conta interna de desenvolvedor.
# Preencha em backend/.env local, execute npm run criar-desenvolvedor e remova a senha depois.
DESENVOLVEDOR_NOME=
DESENVOLVEDOR_EMAIL=
DESENVOLVEDOR_SENHA=
